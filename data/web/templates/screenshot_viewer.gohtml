<div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 lg:p-8 bg-slate-950/90 backdrop-blur-md animate-fade-in"
     onclick="if(event.target === this) window.closeModal()">
    <div class="glass-panel max-w-5xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden bg-slate-900/95 border-slate-700/80">
        
        <!-- Viewer Header -->
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-800 bg-slate-900/90">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-indigo-500/15 text-indigo-400 rounded-xl border border-indigo-500/25">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-bold text-white flex items-center space-x-2">
                        <span>Screenshot Preview</span>
                        <span class="text-slate-600">&bull;</span>
                        <span class="text-indigo-400 font-mono text-xs sm:text-sm font-semibold">{{.Target}}</span>
                    </h3>
                    <p class="text-[11px] text-slate-400 font-mono">
                        {{.Timestamp.Format "2006-01-02 15:04:05"}} &bull; {{.MimeType}} &bull; {{len .Data}} bytes
                    </p>
                </div>
            </div>
            <button onclick="window.closeModal()" title="Close Lightbox (Esc)" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Image Container -->
        <div class="flex-1 overflow-auto bg-[#060911] p-4 flex items-center justify-center min-h-[280px]">
            <img src="/screenshots/{{.ID}}/raw" alt="Screenshot {{.ID}}" class="max-w-full max-h-[68vh] object-contain rounded-lg border border-slate-800 shadow-2xl">
        </div>

        <!-- Viewer Footer Toolbar -->
        <div class="flex items-center justify-between px-5 py-3 border-t border-slate-800 bg-slate-900/90 text-xs">
            <span class="text-slate-400 font-mono text-[11px] hidden sm:inline">
                ID: <span class="text-slate-300">{{.ID}}</span>
            </span>
            <div class="flex items-center space-x-2.5 ml-auto sm:ml-0">
                <a href="/screenshots/{{.ID}}/raw" download="{{.Filename}}"
                   class="px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition shadow flex items-center space-x-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>Download PNG</span>
                </a>
                <button type="button" onclick="window.closeModal()"
                        class="px-3.5 py-1.5 text-xs font-medium text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
