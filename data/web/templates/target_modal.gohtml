<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md animate-fade-in">
    <div class="glass-panel max-w-md w-full p-6 shadow-2xl relative space-y-5 bg-slate-900/95 border-slate-700/80">
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div class="flex items-center space-x-3">
                <div class="p-2.5 bg-indigo-500/15 text-indigo-400 rounded-xl border border-indigo-500/25">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-white tracking-tight">Register Target Display</h3>
                    <p class="text-xs text-slate-400">Add a display node or channel identifier</p>
                </div>
            </div>
            <button onclick="window.closeModal()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Add Target Form -->
        <form hx-post="/api/targets/add" hx-target="#displays-grid" class="space-y-4"
              hx-on::after-request="if(event.detail.successful) window.closeModal()">
            <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Target ID / Client Key <span class="text-rose-400">*</span></label>
                <input type="text" name="id" required
                       placeholder="e.g. display02 or lobby-screen"
                       class="w-full bg-slate-950/90 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-mono">
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Human-Readable Name <span class="text-slate-500 font-normal">(Optional)</span></label>
                <input type="text" name="name"
                       placeholder="e.g. Main Lobby Display"
                       class="w-full bg-slate-950/90 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-indigo-500">
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Broadcast Channel <span class="text-slate-500 font-normal">(Optional)</span></label>
                <div class="space-y-1.5">
                    <input type="text" id="target-channel-input" name="channel"
                           placeholder="e.g. display or foyer"
                           class="w-full bg-slate-950/90 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-mono">
                    <div class="flex items-center space-x-1.5 text-[10px] text-slate-400">
                        <span>Presets:</span>
                        <button type="button" onclick="document.getElementById('target-channel-input').value='display'"
                                class="px-1.5 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">display</button>
                        <button type="button" onclick="document.getElementById('target-channel-input').value='all'"
                                class="px-1.5 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">all</button>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-800">
                <button type="button" onclick="window.closeModal()"
                        class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 rounded-lg transition shadow-md flex items-center space-x-1.5">
                    <span class="htmx-indicator animate-spin-fast">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </span>
                    <span>Register Target</span>
                </button>
            </div>
        </form>
    </div>
</div>
