<div id="display-card-{{.ID}}"
     class="display-card glass-panel p-5 flex flex-col justify-between space-y-4 transition"
     data-target-id="{{.ID}}"
     data-target-name="{{.Name}}"
     data-target-channel="{{.Channel}}"
     data-target-url="{{.CurrentURL}}"
     data-active="{{if .IsActive}}true{{else}}false{{end}}">

    <div class="space-y-4">
        <!-- Top Header: Status, Target Identity & Delete Action -->
        <div class="flex items-start justify-between gap-2">
            <div class="space-y-1">
                <div class="flex items-center space-x-2">
                    <span class="status-dot {{if .IsActive}}status-dot-online{{else}}status-dot-offline{{end}}"></span>
                    <h3 class="font-bold text-white text-base tracking-tight leading-none">{{.Name}}</h3>
                </div>
                <div class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 font-mono">
                    <span class="text-indigo-400 font-semibold bg-indigo-500/10 px-1.5 py-0.5 rounded border border-indigo-500/20 text-[11px]">{{.ID}}</span>
                    {{if .Channel}}
                    <span class="px-1.5 py-0.5 text-[10px] rounded bg-slate-800 text-slate-300 border border-slate-700">
                        #{{.Channel}}
                    </span>
                    {{end}}
                    <span class="px-1.5 py-0.5 text-[10px] rounded font-medium {{if .IsActive}}badge-online{{else}}badge-offline{{end}}">
                        {{if .IsActive}}ONLINE{{else}}OFFLINE{{end}}
                    </span>
                </div>
            </div>

            <!-- Delete Target Button -->
            <button hx-delete="/api/targets/{{.ID}}"
                    hx-target="#display-card-{{.ID}}"
                    hx-swap="outerHTML"
                    hx-confirm="Are you sure you want to remove target '{{.ID}}' from the controller?"
                    title="Remove target display"
                    class="p-1.5 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition border border-transparent hover:border-rose-500/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </button>
        </div>

        <!-- Inline Quick URL Navigation Bar -->
        <div class="bg-slate-950/80 border border-slate-800/90 rounded-xl p-2.5 space-y-2">
            <div class="flex items-center justify-between text-[11px] text-slate-400">
                <span class="font-medium text-slate-300 flex items-center space-x-1">
                    <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                    </svg>
                    <span>Target URL</span>
                </span>
                <span class="text-slate-500 font-mono text-[10px]">
                    {{if not .LastSeen.IsZero}}Seen: {{.LastSeen.Format "15:04:05"}}{{else}}Not seen yet{{end}}
                </span>
            </div>

            <!-- Inline Navigation Form -->
            <form hx-post="/api/displays/{{.ID}}/navigate" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML" class="flex items-center space-x-1.5">
                <div class="relative flex-1">
                    <input type="url" name="url" value="{{.CurrentURL}}" placeholder="https://..." required
                           class="w-full px-2.5 py-1.5 text-xs bg-slate-900 border border-slate-800 rounded-lg text-emerald-400 font-mono focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 placeholder-slate-600 transition">
                </div>
                <button type="submit" title="Navigate this display"
                        class="px-2.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 rounded-lg transition shadow-sm flex items-center space-x-1 shrink-0">
                    <span class="htmx-indicator animate-spin-fast">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </span>
                    <svg class="w-3.5 h-3.5 htmx-hide-on-request" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    <span>Go</span>
                </button>
            </form>
        </div>

        <!-- Telemetry Data Grid -->
        {{if .LastStatus}}
        <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="bg-slate-900/60 rounded-lg p-2 border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] uppercase font-medium">Viewport</span>
                <span class="text-slate-200 font-mono text-[11px]">{{.LastStatus.BrowserConfig.Width}}x{{.LastStatus.BrowserConfig.Height}}</span>
            </div>
            <div class="bg-slate-900/60 rounded-lg p-2 border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] uppercase font-medium">Mode</span>
                <span class="text-slate-200 font-mono text-[11px]">{{if .LastStatus.BrowserConfig.Kiosk}}Kiosk{{else}}Windowed{{end}}</span>
            </div>
            <div class="bg-slate-900/60 rounded-lg p-2 border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] uppercase font-medium">Uptime</span>
                <span class="text-slate-200 font-mono text-[11px]">{{.LastStatus.Uptime}}</span>
            </div>
            <div class="bg-slate-900/60 rounded-lg p-2 border border-slate-800/80">
                <span class="text-slate-400 block text-[10px] uppercase font-medium">NTP Sync</span>
                <span class="font-mono text-[11px] {{if .LastStatus.NTP.Synced}}text-emerald-400{{else}}text-amber-400{{end}}">
                    {{if .LastStatus.NTP.Synced}}Synced ({{.LastStatus.NTP.OffsetString}}){{else}}Awaiting{{end}}
                </span>
            </div>
        </div>
        {{end}}

        <!-- Screenshot Thumbnail Box -->
        <div class="thumbnail-box border border-slate-800/80 rounded-xl relative group">
            {{if .LatestImage}}
            <img src="/screenshots/{{.LatestImage.ID}}/raw" alt="Screenshot of {{.ID}}" class="w-full h-full object-cover">
            <div class="thumbnail-overlay absolute inset-0 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center gap-2 p-2">
                <button hx-get="/modal/screenshot/{{.LatestImage.ID}}" hx-target="#modal-container" hx-swap="innerHTML"
                        class="px-2.5 py-1 text-xs bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium shadow flex items-center space-x-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                    <span>View Lightbox</span>
                </button>
                <button hx-post="/api/displays/{{.ID}}/screenshot" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML"
                        class="px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-medium shadow flex items-center space-x-1 border border-slate-700">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                    </svg>
                    <span>Capture</span>
                </button>
            </div>
            {{else}}
            <div class="w-full h-full flex flex-col items-center justify-center p-4 text-center space-y-2">
                <svg class="h-7 w-7 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <div class="text-[11px] text-slate-500">No screenshot recorded</div>
                <button hx-post="/api/displays/{{.ID}}/screenshot" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML"
                        class="px-2.5 py-1 text-[11px] font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition flex items-center space-x-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                    </svg>
                    <span>Capture Screenshot</span>
                </button>
            </div>
            {{end}}
        </div>
    </div>

    <!-- Actions Footer Toolbar -->
    <div class="pt-3 border-t border-slate-800/80 grid grid-cols-4 gap-1.5">
        <!-- Preset / Modal Navigate -->
        <button hx-get="/modal/navigate?target={{.ID}}" hx-target="#modal-container" hx-swap="innerHTML"
                title="Open Advanced Navigate Dialog"
                class="px-2 py-1.5 text-xs font-medium text-slate-200 bg-slate-900 hover:bg-indigo-600 hover:text-white rounded-lg transition text-center border border-slate-800 hover:border-indigo-500 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5 text-indigo-400 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="hidden sm:inline">Presets</span>
        </button>

        <!-- Get Current URL -->
        <button hx-post="/api/displays/{{.ID}}/geturl" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML"
                title="Fetch Active URL from Display"
                class="px-2 py-1.5 text-xs font-medium text-slate-200 bg-slate-900 hover:bg-slate-800 hover:text-white rounded-lg transition text-center border border-slate-800 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
            </svg>
            <span class="hidden sm:inline">Get URL</span>
        </button>

        <!-- Refresh Status -->
        <button hx-post="/api/displays/{{.ID}}/status" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML"
                title="Query Display Node Telemetry"
                class="px-2 py-1.5 text-xs font-medium text-slate-200 bg-slate-900 hover:bg-slate-800 hover:text-white rounded-lg transition text-center border border-slate-800 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span class="hidden sm:inline">Status</span>
        </button>

        <!-- Capture Screenshot -->
        <button hx-post="/api/displays/{{.ID}}/screenshot" hx-target="#display-card-{{.ID}}" hx-swap="outerHTML"
                title="Capture Screenshot Immediately"
                class="px-2 py-1.5 text-xs font-medium text-slate-200 bg-slate-900 hover:bg-indigo-600 hover:text-white rounded-lg transition text-center border border-slate-800 hover:border-indigo-500 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            </svg>
            <span class="hidden sm:inline">Snap</span>
        </button>
    </div>
</div>
