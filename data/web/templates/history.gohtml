{{range .Entries}}
<tr class="hover:bg-slate-800/40 transition group">
    <td class="py-3 px-4 text-slate-400 whitespace-nowrap font-mono text-[11px]">{{.Timestamp.Format "15:04:05.000"}}</td>
    <td class="py-3 px-4 whitespace-nowrap">
        <span class="font-semibold text-indigo-400 font-mono text-xs bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20">
            {{.Target}}
        </span>
    </td>
    <td class="py-3 px-4 text-slate-200 font-mono text-xs">{{.Command}}</td>
    <td class="py-3 px-4 text-slate-400 whitespace-nowrap font-mono text-xs">{{.Duration.Truncate 1000000}}</td>
    <td class="py-3 px-4 whitespace-nowrap">
        {{if eq .Status "OK"}}
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-semibold badge-online">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>OK</span>
        </span>
        {{else}}
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/15 text-rose-400 border border-rose-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
            <span>ERROR</span>
        </span>
        {{end}}
    </td>
    <td class="py-3 px-4 text-slate-300 font-mono text-xs">
        <div class="flex items-center justify-between space-x-2 max-w-sm">
            <span class="truncate" title="{{.Message}}">{{if .Message}}{{.Message}}{{else}}-{{end}}</span>
            {{if .Message}}
            <button onclick="navigator.clipboard.writeText('{{.Message}}'); window.showToast('info', 'Clipboard', 'Message copied to clipboard');"
                    title="Copy details"
                    class="opacity-0 group-hover:opacity-100 transition p-1 text-slate-400 hover:text-white hover:bg-slate-800 rounded">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                </svg>
            </button>
            {{end}}
        </div>
    </td>
</tr>
{{else}}
<tr>
    <td colspan="6" class="py-8 text-center text-slate-500 text-xs space-y-1">
        <p class="font-medium text-slate-400">No command executions recorded yet</p>
        <p class="text-[11px] text-slate-600">Commands dispatched from display cards or the bulk action toolbar will appear here in real time.</p>
    </td>
</tr>
{{end}}
